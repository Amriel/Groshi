{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Гроші",
  "version": "1.31.7",
  "identifier": "ua.groshi.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Гроші",
        "width": 1360,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Oleksandr",
    "copyright": "",
    "shortDescription": "Облік витрат на даних Monobank",
    "longDescription": "Гроші — облік витрат, підписок і кошторисів проєктів. Дані тягнуться напряму з Monobank і лежать на вашому диску.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Ukrainian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}